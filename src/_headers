# Cabeçalhos do Cloudflare Pages. Espelham o .htaccess, que só valia na Hostinger.
# O Cloudflare já envia X-Content-Type-Options: nosniff e
# Referrer-Policy: strict-origin-when-cross-origin por padrão.
# Regras não se sobrepõem: se duas casarem com o mesmo caminho e
# definirem o mesmo cabeçalho, o Cloudflare junta os valores.

/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS e JS são referenciados com ?v=hash, então podem ficar 1 ano em cache.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# /assets/* fica sem regra de propósito e usa o padrão do Cloudflare
# (public, max-age=14400, must-revalidate). Um max-age longo faz a borda do
# Cloudflare guardar o arquivo antigo mesmo depois de um deploy, e imagens e o
# currículo não têm versão na URL. Em novembro de 2026, 7 dias aqui deixaram o
# currículo desatualizado no ar após uma publicação.
