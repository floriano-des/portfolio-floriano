            <span>taxa de conversão da nova versão</span>
          </div>
          <div class="case-stat">
            <strong>+194%</strong>
            <span>crescimento relativo confirmado no teste A/B</span>
          </div>
        </div>

        <div class="case-table-wrap">
          <table class="case-table">
            <thead>
              <tr>
                <th>Métrica</th>
                <th>V1 antiga</th>
                <th>V2 nova</th>
              </tr>
