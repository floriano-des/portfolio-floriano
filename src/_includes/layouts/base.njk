<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  {% include "partials/gtm-head.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "partials/motion-head.njk" %}

  <!-- SEO Essencial -->
  <title>{{ title or metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">
  <meta name="author" content="{{ metadata.author }}">
  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type"        content="{{ ogType or 'website' }}">
  <meta property="og:url"         content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:title"       content="{{ title or metadata.title }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:image"       content="{{ ogImage or metadata.ogImage }}">
  <meta property="og:image:alt"   content="{{ ogImageAlt or title or metadata.title }}">
  <meta property="og:locale"      content="pt_BR">
  <meta property="og:site_name"   content="{{ metadata.siteName }}">
  {% if articlePublishedTime %}<meta property="article:published_time" content="{{ articlePublishedTime }}">{% endif %}
  {% if articleModifiedTime %}<meta property="article:modified_time" content="{{ articleModifiedTime }}">{% endif %}
  {% if articleAuthor %}<meta property="article:author" content="{{ articleAuthor }}">{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ title or metadata.title }}">
  <meta name="twitter:description" content="{{ description or metadata.description }}">
  <meta name="twitter:image"       content="{{ ogImage or metadata.ogImage }}">
  <meta name="twitter:image:alt"   content="{{ ogImageAlt or title or metadata.title }}">
  {% include "partials/structured-data.njk" %}
  {% block extraHead %}{% endblock %}

  <!-- Fonts: Montserrat -->
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/montserrat-latin-normal.woff2" crossorigin>
  {% if page.url == "/" %}
  <link rel="preload" as="image" href="/assets/foto-hero-floriano.webp?v={{ '/assets/foto-hero-floriano.webp' | assetVersion }}" fetchpriority="high">
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/assets/favicon.webp">

  <!-- Styles -->
  {% if page.url == "/" %}
  <style>
    {% inlineCss "reset.css", "vendor.lenis.css", "style.tokens.css", "style.nav.css", "style.home.css", "style.footer-motion.css", "style.motion.css" %}
  </style>
  {% else %}
  <link rel="stylesheet" href="/css/reset.css?v={{ '/css/reset.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/vendor.lenis.css?v={{ '/css/vendor.lenis.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.tokens.css?v={{ '/css/style.tokens.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.nav.css?v={{ '/css/style.nav.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.home.css?v={{ '/css/style.home.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.content.css?v={{ '/css/style.content.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.footer-motion.css?v={{ '/css/style.footer-motion.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.responsive.css?v={{ '/css/style.responsive.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.pages.css?v={{ '/css/style.pages.css' | assetVersion }}">
  <link rel="stylesheet" href="/css/style.motion.css?v={{ '/css/style.motion.css' | assetVersion }}">
  {% endif %}
  {% if extraStylesheet %}<link rel="stylesheet" href="{{ extraStylesheet }}?v={{ extraStylesheet | assetVersion }}">{% endif %}
  {% block extraStyles %}{% endblock %}
  <!-- Cobre a página imediatamente se há uma transição pendente, evitando flash -->
  <script>
    (function () {
      try {
        var raw = sessionStorage.getItem('floriano:page-transition');
        var s = raw ? JSON.parse(raw) : null;
        if (s && s.expiresAt > Date.now()) {
          document.documentElement.setAttribute('data-transition-pending', '');
        }
      } catch (_) {}
    }());
  </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K738G4S2"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  {% if page.url == "/" %}
  {% include "partials/preloader.njk" %}
  {% endif %}
  {% include "partials/transition-curtain.njk" %}

  {% if not hideSiteChrome %}
  {% include "partials/nav.njk" %}
  {% endif %}

  {{ content | safe }}

  {% if not hideSiteChrome %}
  {% include "partials/footer.njk" %}
  <button
    class="back-to-top"
    type="button"
    aria-label="Voltar ao topo"
    data-back-to-top
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  {% include "partials/flori-bot.njk" %}
  {% endif %}

  <script src="/js/main.js?v={{ '/js/main.js' | assetVersion }}"></script>
  {% if extraScript %}<script src="{{ extraScript }}?v={{ extraScript | assetVersion }}" defer></script>{% endif %}
  {% include "partials/motion-scripts.njk" %}
</body>
</html>
